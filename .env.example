# ---- Platform ----
NODE_ENV=development
PORT=4100
PLATFORM_URL=http://localhost:3000

# ---- Host ports for the local docker stack (change if these collide) ----
POSTGRES_PORT=55432
REDIS_PORT=56379
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
JAEGER_UI_PORT=16687
OTLP_PORT=4319
SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# ---- Datastores ----
DATABASE_URL=postgresql://helix:helix@localhost:55432/helix?schema=platform
REDIS_URL=redis://localhost:56379

# ---- Auth ----
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ---- Object storage (S3 compatible / MinIO in dev) ----
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=helix-dev
S3_ACCESS_KEY=helixadmin
S3_SECRET_KEY=helixadmin

# ---- Limits ----
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=600
